# RoleFit Server Environment Variables

PORT=3001
NODE_ENV=development

# Google Gemini API Key (Required for live AI processing, fallback sandbox active if empty)
GEMINI_API_KEY=

# MongoDB Connection String (e.g. mongodb+srv://... or mongodb://localhost:27017/rolefit)
MONGODB_URI=

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Operational Configuration
AI_TIMEOUT=30000
MAX_FILE_SIZE=10485760
MAX_CONCURRENT_ANALYSES=3
